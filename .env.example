# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# "auto" uses Gemini if GEMINI_API_KEY is present, then falls back to the
# offline rule-based engine. Force with "gemini" or "heuristic".
LLM_PROVIDER=gemini

# Google Gemini — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini 3.x reasoning depth: low (fast, default) / high / empty to disable.
# Reasoning tokens count against LLM_MAX_TOKENS.
GEMINI_THINKING_LEVEL=low

LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=3000

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
MEMORY_MAX_TURNS=12
SESSION_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PREFIX=/api/v1
CORS_ORIGINS=*
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Logging and monitoring
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
LOG_FILE=logs/app.log
SLOW_REQUEST_MS=3000

# ---------------------------------------------------------------------------
# Features
# ---------------------------------------------------------------------------
ENABLE_RAG=true
RAG_TOP_K=3
MAX_RESUME_PAGES=10

# ---------------------------------------------------------------------------
# UI (used by ui/streamlit_app.py, not the API)
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000

# UI HTTP client timeout (a full LLM coaching turn can exceed 90s)
UI_TIMEOUT_SECONDS=240
